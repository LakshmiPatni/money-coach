# Personal Finance Coach — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Environment ───────────────────────────────────────────────────────────────
# Deployment environment ("development" or "production").
# When set to "production", destructive endpoints like POST /reset are strictly blocked.
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
# For a local single-instance deployment this is a file path.
# Example: DATABASE_URL=finance.db
DATABASE_URL=finance.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use "*" only for local development. Restrict this in any shared or production
# deployment to the exact origin(s) of your frontend.
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://myapp.example.com
ALLOWED_ORIGINS=*

# ── Safety & Maintenance ──────────────────────────────────────────────────────
# Enable POST /reset endpoint to wipe database tables.
# Default is false. Only permitted if ENVIRONMENT is not "production".
ENABLE_RESET=false

# ── Server ────────────────────────────────────────────────────────────────────
# Host and port are configured when starting uvicorn:
#   uvicorn main:app --host 0.0.0.0 --port 8000
# No environment variable is needed unless you write a custom start script.
